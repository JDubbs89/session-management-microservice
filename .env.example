# Copy to src/.env for Docker Compose. Replace development secrets before deployment.
APP_ENV=development
RATE_LIMIT_STORAGE=postgresql
POSTGRES_USER=session_service
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=sessions
DATABASE_URL=postgresql+psycopg2://session_service:local-development-password@db:5432/sessions
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
